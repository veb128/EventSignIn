--shared
--gc-sections
-z relro
-z noexecstack
-z now
--enable-new-dtags
--build-id=sha1
--warn-shared-textrel
--fatal-warnings
--no-rosegment
--export-dynamic
--allow-shlib-undefined
-soname libxamarin-app-clr.so
--fix-cortex-a53-843419
-m aarch64linux
-z max-page-size=16384
-L /usr/local/share/dotnet/packs/Microsoft.Android.Runtime.CoreCLR.37.android-arm64/37.2.31/runtimes/android-arm64/native
obj/Debug/net11.0-android/android/typemaps.arm64-v8a.o
obj/Debug/net11.0-android/android/environment.arm64-v8a.o
obj/Debug/net11.0-android/android/compressed_assemblies.arm64-v8a.o
obj/Debug/net11.0-android/android/marshal_methods.arm64-v8a.o
obj/Debug/net11.0-android/android/jni_remap.arm64-v8a.o
-lc
